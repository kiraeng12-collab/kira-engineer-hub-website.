# Kira Engineer Hub backend environment variables
# Add these in Vercel Project Settings > Environment Variables.

# Keep checkout disabled until legal, refund, delivery, and Stripe setup are complete.
CHECKOUT_ENABLED=false
# Turns on the Telegram access-key automation: after payment the website issues a
# single-use key and the bot grants VIP group + channel access. Keep false until
# launch; set to exactly "true" to enable.
PAYMENT_AUTOMATION_ENABLED=false

# Form delivery (legacy fallback - used automatically when DATABASE_URL is not set)
FORM_WEBHOOK_URL=
ADMIN_WEBHOOK_URL=

# Database (Vercel Postgres / Neon) - required for form storage, rate limiting,
# and (in later phases) membership/auth/Telegram/Early Bird records.
DATABASE_URL=

# Email (Resend) - confirmation and admin-notification emails for form
# submissions. Forms keep working via FORM_WEBHOOK_URL above if these are unset.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS="Kira Engineer Hub <KE@kiraengineerhub.com>"
ADMIN_NOTIFICATION_EMAIL=

# Authentication (Auth.js / NextAuth v4, credentials-based)
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://www.kiraengineerhub.com

# Stripe checkout
STRIPE_SECRET_KEY=
STRIPE_PRICE_KIRA_VIP_MONTHLY=
STRIPE_PRICE_KIRA_VIP_QUARTERLY=
# Founding Member tier (permanent flat discount for members who joined Kira
# Trading Community 2024 or earlier: USD 50/month, USD 140/quarter) - separate
# Stripe Prices, used directly.
STRIPE_PRICE_KIRA_VIP_MONTHLY_FOUNDING=
STRIPE_PRICE_KIRA_VIP_QUARTERLY_FOUNDING=
# Early Bird tier (joined 2025 through 1 Aug 2026: USD 56/month, USD 160/quarter)
# - its own fixed Stripe Prices, used directly (no coupon).
STRIPE_PRICE_KIRA_VIP_MONTHLY_EARLYBIRD=
STRIPE_PRICE_KIRA_VIP_QUARTERLY_EARLYBIRD=
STRIPE_SUCCESS_URL=https://www.kiraengineerhub.com/checkout/success
STRIPE_CANCEL_URL=https://www.kiraengineerhub.com/checkout/cancelled

# Stripe webhook - configure this endpoint in the Stripe Dashboard:
# https://www.kiraengineerhub.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Crypto payments (USDT/TRC20 via NOWPayments, non-custodial - payouts settle to
# the Trust Wallet address set in the NOWPayments dashboard). Set the IPN
# callback in NOWPayments to https://www.kiraengineerhub.com/api/crypto/webhook
# Off until CRYPTO_CHECKOUT_ENABLED is exactly "true".
CRYPTO_CHECKOUT_ENABLED=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# TEMPORARY launch test only: charge this flat USDT amount instead of the real
# price so an end-to-end test costs almost nothing (e.g. 5). REMOVE after testing.
CRYPTO_TEST_AMOUNT=
# Secret Vercel Cron uses to authorize the crypto expiry sweep (/api/crypto/sweep).
CRON_SECRET=

# Telegram membership onboarding (see docs/backend-phase-7.md for setup).
# Bot token and username from @BotFather; group chat ID from the private
# VIP group the bot has been added to as an admin.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_GROUP_CHAT_ID=
# VIP channel id (membership covers the group AND the channel). Optional:
# if unset, members are only invited to - and only removed from - the group.
TELEGRAM_CHANNEL_CHAT_ID=

# Your personal Telegram user id. When set, the website DMs you here (via the
# bot) the moment a member's VIP subscription lapses and access is removed, so
# you can nudge a renewal. Optional; expiry alerts are skipped if unset.
TELEGRAM_OWNER_CHAT_ID=

# Shared secret the KIRA bot sends (header x-kira-bot-secret) when it calls
# /api/telegram/verify (VIP access keys) and /api/telegram/verify-discount
# (loyalty pricing). MUST exactly match the bot's KIRA_VERIFY_SECRET. Required
# for the automated VIP access + discount-claim flow.
TELEGRAM_BOT_VERIFY_SECRET=

# Telegram webhook - register with setWebhook using this URL and secret_token:
# https://www.kiraengineerhub.com/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=

# Lot Sizing Calculator - signs the short-lived signal-prefill tokens used by
# the "Calculate My Lot Size" buttons under KIRA signals. Generate with:
# openssl rand -base64 32. If unset, signal deep-links are simply not
# prefilled (the calculator still works); the Telegram bot must sign links with
# the SAME value via buildSignalToken() in lib/tools/signal-prefill.ts.
LOTSIZE_SIGNAL_SECRET=
# The Lot Sizing Calculator Telegram Mini App URL (opened from the bot's menu
# button). Optional; only needed if you expose the calculator as a Mini App.
LOTSIZE_MINIAPP_URL=

# Partner / affiliate program (Rewardful). Public, client-side key used by the
# Partner Network pages to attribute referrals. Optional - referral tracking is
# simply skipped if unset.
NEXT_PUBLIC_REWARDFUL_API_KEY=

# Canonical site origin, used as a fallback when building absolute URLs.
SITE_URL=https://www.kiraengineerhub.com

# Informational: the Stripe webhook endpoint (referenced by the setup/check
# scripts). Configure the actual endpoint in the Stripe Dashboard.
STRIPE_WEBHOOK_URL=https://www.kiraengineerhub.com/api/stripe/webhook

# Copy-trading bridge (FUTURE add-on, advertised only inside Telegram - NOT
# required for the website launch). Leave unset until the copy engine goes live.
COPY_BRIDGE_URL=
COPY_BRIDGE_OWNER_KEY=
